<% layout('layouts/boilerplate') -%>

<div class="py-5 bg-white border-bottom">
  <div class="container">
    <div class="row align-items-center g-5">
      <div class="col-lg-6">
        <span class="badge bg-teal-subtle text-teal text-uppercase px-3 py-1 mb-2">About Our Mission</span>
        <h1 class="display-5 fw-bold text-dark tracking-tight mb-3">Bridging Healthcare Gaps Through Direct Community Action</h1>
        <p class="lead text-secondary mb-3">
          The Medical Camp Registration Portal was created to make free community healthcare transparent, organized, and accessible to every citizen.
        </p>
        <p class="text-secondary">
          Millions of individuals skip essential preventive checkups due to financial stress, transportation barriers, or overloaded public clinics. Community medical camps deliver primary diagnosis, specialist reviews, and early screenings right into community centers, school auditoriums, and municipal halls.
        </p>
      </div>
      <div class="col-lg-6">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
          <img src="https://images.unsplash.com/photo-1584515979956-d9f6e5d09982?auto=format&fit=crop&w=800&q=80" alt="Healthcare outreach team" class="w-100" onerror="this.src='/images/camp-default.svg'">
        </div>
      </div>
    </div>
  </div>
</div>

<div class="py-5 bg-light">
  <div class="container">
    <div class="text-center max-w-700 mx-auto mb-5" style="max-width: 720px;">
      <h2 class="fw-bold text-dark">Our Core Commitments</h2>
      <p class="text-secondary">We hold every medical camp and participating clinic to rigorous standards of patient dignity and clinical quality.</p>
    </div>

    <div class="row g-4">
      <div class="col-md-4">
        <div class="feature-card">
          <div class="feature-icon-circle bg-teal text-white">
            <i class="bi bi-shield-check"></i>
          </div>
          <h5 class="fw-bold text-dark">Zero Patient Financial Burden</h5>
          <p class="text-secondary small mb-0">
            Consultations, vital checks, point-of-care rapid diagnostics, and essential starter medications provided at camps are 100% free of charge.
          </p>
        </div>
      </div>

      <div class="col-md-4">
        <div class="feature-card">
          <div class="feature-icon-circle bg-primary text-white">
            <i class="bi bi-person-heart"></i>
          </div>
          <h5 class="fw-bold text-dark">Compassionate &amp; Dignified Care</h5>
          <p class="text-secondary small mb-0">
            Every patient is treated with utmost respect, confidentiality, and empathy. Medical advice is communicated clearly in patient-friendly language.
          </p>
        </div>
      </div>

      <div class="col-md-4">
        <div class="feature-card">
          <div class="feature-icon-circle bg-success text-white">
            <i class="bi bi-link-45deg"></i>
          </div>
          <h5 class="fw-bold text-dark">Continuity of Treatment</h5>
          <p class="text-secondary small mb-0">
            Patients identified with critical conditions receive formal referrals to partner charitable hospitals and tertiary care institutes for ongoing therapy.
          </p>
        </div>
      </div>
    </div>

    <!-- Demonstration Notice -->
    <div class="mt-5 p-4 rounded-4 bg-white border shadow-sm text-center">
      <span class="badge bg-secondary mb-2">Academic &amp; Portfolio Project</span>
      <h5 class="fw-bold text-dark mb-1">Sysslan IT Solutions Software Development Task</h5>
      <p class="text-secondary small mb-0" style="max-width: 650px; margin: 0 auto;">
        This application is an educational, production-ready demonstration platform built with Node.js, Express, MongoDB, EJS, and Bootstrap 5 to illustrate real-world healthtech workflows.
      </p>
    </div>
  </div>
</div>
