<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle || 'Administrator Login - Medical Camp Portal' %></title>
  
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Bootstrap 5 CSS CDN -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-light d-flex align-items-center justify-content-center min-vh-100 py-4">

  <div class="container" style="max-width: 460px;">
    <!-- Logo & Portal Title -->
    <div class="text-center mb-4">
      <div class="d-inline-flex align-items-center justify-content-center brand-icon-box mb-2" style="width: 50px; height: 50px;">
        <i class="bi bi-hospital fs-3 text-white"></i>
      </div>
      <h3 class="fw-bold text-dark mb-1">Medical Camp Portal</h3>
      <span class="badge bg-teal-subtle text-teal text-uppercase px-3 py-1">Administrative Access Only</span>
    </div>

    <!-- Flash Messages -->
    <% if (error_msg && error_msg.length > 0) { %>
      <div class="alert alert-danger shadow-sm border-0 d-flex align-items-center mb-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-5 me-2 text-danger"></i>
        <div class="small flex-grow-1"><%= error_msg %></div>
      </div>
    <% } %>

    <% if (success_msg && success_msg.length > 0) { %>
      <div class="alert alert-success shadow-sm border-0 d-flex align-items-center mb-3" role="alert">
        <i class="bi bi-check-circle-fill fs-5 me-2 text-success"></i>
        <div class="small flex-grow-1"><%= success_msg %></div>
      </div>
    <% } %>

    <!-- Login Card -->
    <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 bg-white mb-3">
      <h5 class="fw-bold text-dark mb-4">Administrator Sign In</h5>

      <form action="/admin/login" method="POST">
        <div class="mb-3">
          <label for="emailOrUsername" class="form-label">Email or Username</label>
          <div class="input-group">
            <span class="input-group-text bg-white text-muted"><i class="bi bi-person"></i></span>
            <input type="text" class="form-control" id="emailOrUsername" name="emailOrUsername" placeholder="admin@medicalcamp.org" required autofocus>
          </div>
        </div>

        <div class="mb-4">
          <label for="password" class="form-label">Password</label>
          <div class="input-group">
            <span class="input-group-text bg-white text-muted"><i class="bi bi-lock"></i></span>
            <input type="password" class="form-control" id="password" name="password" placeholder="••••••••" required>
          </div>
        </div>

        <div class="d-grid mb-3">
          <button type="submit" class="btn btn-teal py-2 fw-bold" id="btnAdminLogin">
            <i class="bi bi-box-arrow-in-right me-1"></i> Sign In to Dashboard
          </button>
        </div>
      </form>

      <div class="text-center pt-2 border-top">
        <a href="/" class="small text-decoration-none text-muted hover-teal">
          <i class="bi bi-arrow-left me-1"></i> Back to Public Patient Portal
        </a>
      </div>
    </div>

    <!-- Demonstration Credentials Helper Card -->
    <div class="card border-0 shadow-sm rounded-3 bg-white p-3">
      <div class="d-flex align-items-center gap-2 mb-2">
        <i class="bi bi-key-fill text-warning"></i>
        <strong class="small text-dark">Demo Admin Credentials:</strong>
      </div>
      <div class="small text-secondary bg-light p-2 rounded border font-monospace">
        <div><strong>Email:</strong> admin@medicalcamp.org</div>
        <div><strong>Password:</strong> Admin@12345</div>
      </div>
      <div class="form-text small text-muted mt-2">
        Protected session authentication with bcrypt password encryption.
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
