<% layout('layouts/boilerplate') -%>

<div class="container py-5 my-5 text-center">
  <div class="row justify-content-center">
    <div class="col-md-7">
      <div class="display-3 fw-bold text-danger mb-3">
        <i class="bi bi-exclamation-triangle-fill"></i>
      </div>
      <h2 class="fw-bold text-dark mb-3"><%= pageTitle || 'An Error Occurred' %></h2>
      <p class="lead text-secondary mb-4">
        <%= message || 'An unexpected server issue occurred while processing your request. Please try again later or contact our technical helpdesk.' %>
      </p>
      <div class="d-flex justify-content-center gap-3">
        <a href="/" class="btn btn-teal px-4 py-2">
          <i class="bi bi-house-door me-1"></i> Back to Home
        </a>
        <a href="/contact" class="btn btn-outline-secondary px-4 py-2">
          <i class="bi bi-envelope me-1"></i> Contact Support
        </a>
      </div>
    </div>
  </div>
</div>
