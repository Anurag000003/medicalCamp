<% layout('layouts/boilerplate') -%>

<div class="py-4 bg-white border-bottom">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-8">
        <span class="badge bg-teal-subtle text-teal text-uppercase px-3 py-1 mb-2">Participant Registration</span>
        <h1 class="display-6 fw-bold text-dark mb-1">Free Medical Camp Registration</h1>
        <p class="text-secondary mb-0">Fill out this quick form to reserve your free registration pass and consultation appointment.</p>
      </div>
      <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
        <a href="/registrations/lookup" class="btn btn-outline-secondary px-3 py-2 small">
          <i class="bi bi-search me-1"></i> Already Registered? Find Pass
        </a>
      </div>
    </div>
  </div>
</div>

<div class="py-5 bg-light">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <!-- Server-side validation errors summary -->
        <% if (formErrors && formErrors.length > 0) { %>
          <div class="alert alert-danger shadow-sm border-0 mb-4" role="alert">
            <div class="d-flex align-items-center mb-2">
              <i class="bi bi-exclamation-triangle-fill fs-5 me-2 text-danger"></i>
              <strong class="fs-6">Please resolve the following before submitting:</strong>
            </div>
            <ul class="mb-0 ps-3 small">
              <% formErrors.forEach(err => { %>
                <li><%= err.msg %></li>
              <% }) %>
            </ul>
          </div>
        <% } %>

        <div class="form-card p-4 p-md-5">
          <form action="/register" method="POST" id="campRegistrationForm" novalidate>
            
            <!-- Section 1: Camp Selection -->
            <div class="mb-4 pb-3 border-bottom">
              <h5 class="fw-bold text-dark mb-3 border-start border-3 border-teal ps-2">Step 1: Select Your Preferred Medical Camp</h5>
              
              <div class="mb-3">
                <label for="campSelect" class="form-label">Medical Camp <span class="text-danger">*</span></label>
                <select class="form-select form-select-lg" id="campSelect" name="campId" required>
                  <option value="" disabled <%= !selectedCampId ? 'selected' : '' %>>-- Select an upcoming medical camp --</option>
                  <% availableCamps.forEach(camp => { %>
                    <% const isSelected = selectedCampId && selectedCampId.toString() === camp._id.toString(); %>
                    <option 
                      value="<%= camp._id %>" 
                      <%= isSelected ? 'selected' : '' %>
                      data-date="<%= camp.formattedDate %> (<%= camp.startTime %>)"
                      data-venue="<%= camp.location.venue %>, <%= camp.location.city %>"
                      data-seats-left="<%= camp.remainingCapacity %>"
                      data-capacity="<%= camp.capacity %>"
                      <%= !camp.isOpen ? 'disabled' : '' %>
                    >
                      <%= camp.name %> — <%= camp.location.city %> (<%= camp.formattedDate %>) <%= !camp.isOpen ? '[FULL/CLOSED]' : '' %>
                    </option>
                  <% }) %>
                </select>
                <div class="invalid-feedback">Please select a valid upcoming medical camp.</div>
              </div>

              <!-- Selected Camp Live Preview Card -->
              <div id="selectedCampPreview" class="p-3 bg-light rounded-3 border <%= (typeof selectedCamp !== 'undefined' && selectedCamp) ? '' : 'd-none' %>">
                <div id="campPreviewContent">
                  <% if (typeof selectedCamp !== 'undefined' && selectedCamp) { %>
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                      <div>
                        <strong class="text-teal"><%= selectedCamp.name %></strong>
                        <div class="small text-muted">
                          <i class="bi bi-calendar-event me-1"></i> <%= selectedCamp.formattedDate %> (<%= selectedCamp.startTime %>) &nbsp;|&nbsp; 
                          <i class="bi bi-geo-alt me-1"></i> <%= selectedCamp.location.venue %>, <%= selectedCamp.location.city %>
                        </div>
                      </div>
                      <div>
                        <span class="badge <%= selectedCamp.remainingCapacity <= 10 ? 'bg-danger' : 'bg-success' %> fs-6 px-3 py-2">
                          <i class="bi bi-ticket-perforated me-1"></i> <%= selectedCamp.remainingCapacity %> / <%= selectedCamp.capacity %> Seats Left
                        </span>
                      </div>
                    </div>
                  <% } %>
                </div>
              </div>
            </div>

            <!-- Section 2: Personal Details -->
            <div class="mb-4 pb-3 border-bottom">
              <h5 class="fw-bold text-dark mb-3 border-start border-3 border-teal ps-2">Step 2: Participant Information</h5>
              
              <div class="row g-3">
                <!-- Full Name -->
                <div class="col-md-8">
                  <label for="fullName" class="form-label">Full Name of Participant <span class="text-danger">*</span></label>
                  <input type="text" class="form-control" id="fullName" name="fullName" value="<%= formData.fullName || '' %>" placeholder="e.g. Jane Doe" minlength="2" maxlength="100" required>
                  <div class="invalid-feedback">Full name is required (2-100 characters).</div>
                </div>

                <!-- Age -->
                <div class="col-md-4">
                  <label for="age" class="form-label">Age (in years) <span class="text-danger">*</span></label>
                  <input type="number" class="form-control" id="age" name="age" value="<%= formData.age || '' %>" min="1" max="120" placeholder="e.g. 45" required>
                  <div class="invalid-feedback">Please enter a valid age (1-120).</div>
                </div>

                <!-- Contact Number -->
                <div class="col-md-6">
                  <label for="contactNumber" class="form-label">Contact Phone Number <span class="text-danger">*</span></label>
                  <input type="tel" class="form-control" id="contactNumber" name="contactNumber" value="<%= formData.contactNumber || '' %>" placeholder="e.g. 555-234-5678" pattern="^(\+?[0-9\s-]{7,15})$" required>
                  <div class="invalid-feedback">Please enter a valid 7-15 digit phone number.</div>
                </div>

                <!-- Email -->
                <div class="col-md-6">
                  <label for="email" class="form-label">Email Address <span class="text-danger">*</span></label>
                  <input type="email" class="form-control" id="email" name="email" value="<%= formData.email || '' %>" placeholder="e.g. jane.doe@example.com" required>
                  <div class="invalid-feedback">A valid email address is required for confirmation pass.</div>
                </div>

                <!-- Gender -->
                <div class="col-md-4">
                  <label for="gender" class="form-label">Gender <span class="text-muted small">(Optional)</span></label>
                  <select class="form-select" id="gender" name="gender">
                    <option value="Prefer not to say" <%= formData.gender === 'Prefer not to say' ? 'selected' : '' %>>Prefer not to say</option>
                    <option value="Female" <%= formData.gender === 'Female' ? 'selected' : '' %>>Female</option>
                    <option value="Male" <%= formData.gender === 'Male' ? 'selected' : '' %>>Male</option>
                    <option value="Other" <%= formData.gender === 'Other' ? 'selected' : '' %>>Other</option>
                  </select>
                </div>

                <!-- Address -->
                <div class="col-md-8">
                  <label for="address" class="form-label">City or Residential Address <span class="text-danger">*</span></label>
                  <input type="text" class="form-control" id="address" name="address" value="<%= formData.address || '' %>" placeholder="e.g. 45 Oakwood Dr, Springfield" minlength="3" maxlength="300" required>
                  <div class="invalid-feedback">Please enter your city or residential address.</div>
                </div>

                <!-- Reason / Symptoms -->
                <div class="col-12">
                  <label for="reasonForParticipation" class="form-label">Chief Reason for Attendance / Symptoms <span class="text-muted small">(Optional)</span></label>
                  <textarea class="form-control" id="reasonForParticipation" name="reasonForParticipation" rows="2" maxlength="500" placeholder="e.g. Seeking routine cardiac checkup, blurred vision in left eye, or blood sugar evaluation."><%= formData.reasonForParticipation || '' %></textarea>
                  <div class="form-text small">Notice: Do not disclose highly confidential health records. Brief symptoms help us prepare specialist desks.</div>
                </div>
              </div>
            </div>

            <!-- Section 3: Consent & Confirmation -->
            <div class="mb-4">
              <div class="form-check p-3 bg-light rounded-3 border">
                <input class="form-check-input ms-0 me-2" type="checkbox" id="consentCheck" name="consent" required <%= formData.consent ? 'checked' : '' %>>
                <label class="form-check-label small text-secondary" for="consentCheck">
                  <strong>Participant Declaration &amp; Consent <span class="text-danger">*</span></strong><br>
                  I voluntarily register for this free community medical outreach camp. I agree to present a valid photo ID matching this name at the venue reception. I understand that medical camp screenings provide outpatient preventive evaluations and do not replace emergency hospital trauma care.
                </label>
                <div class="invalid-feedback">You must review and accept the consent agreement to proceed.</div>
              </div>
            </div>

            <!-- Submit Button -->
            <div class="d-grid gap-2">
              <button type="submit" class="btn btn-teal btn-lg py-3 fw-bold" id="btnSubmitRegistration">
                <i class="bi bi-shield-check me-2"></i> Confirm Free Registration &amp; Generate Pass
              </button>
            </div>
            <div class="text-center small text-muted mt-2">
              <i class="bi bi-lock-fill me-1"></i> Your personal details are protected and never shared or sold.
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
