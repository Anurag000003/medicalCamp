<% layout('layouts/boilerplate') -%>

<div class="container py-5 my-5 text-center">
  <div class="row justify-content-center">
    <div class="col-md-7">
      <div class="display-1 fw-extrabold text-teal mb-3">404</div>
      <h2 class="fw-bold text-dark mb-3">Medical Resource Not Found</h2>
      <p class="lead text-secondary mb-4">
        <%= message || 'The medical camp listing, registration pass, or page you are attempting to access does not exist or has been relocated.' %>
      </p>
      <div class="d-flex justify-content-center gap-3">
        <a href="/" class="btn btn-teal px-4 py-2">
          <i class="bi bi-house-door me-1"></i> Return Home
        </a>
        <a href="/camps" class="btn btn-outline-secondary px-4 py-2">
          <i class="bi bi-calendar-check me-1"></i> Browse Camps
        </a>
      </div>
    </div>
  </div>
</div>
