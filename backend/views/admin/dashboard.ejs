<% layout('layouts/boilerplate') -%>

<!-- Admin Header Bar -->
<div class="py-4 bg-white border-bottom">
  <div class="container">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
      <div>
        <div class="d-flex align-items-center gap-2 mb-1">
          <span class="badge bg-teal-subtle text-teal text-uppercase px-3 py-1">Administrator Control Panel</span>
          <span class="badge bg-light text-muted border"><i class="bi bi-clock me-1"></i> System Active</span>
        </div>
        <h1 class="h3 fw-bold text-dark mb-0">Medical Camp Operational Dashboard</h1>
        <p class="text-secondary small mb-0">Welcome back, <strong><%= currentAdmin ? currentAdmin.name : 'Administrator' %></strong>. Review live camp registrations and clinic logistics.</p>
      </div>

      <div class="d-flex gap-2 flex-wrap">
        <a href="/admin/camps/new" class="btn btn-teal btn-sm px-3 py-2">
          <i class="bi bi-plus-circle me-1"></i> Create Medical Camp
        </a>
        <a href="/admin/registrations" class="btn btn-outline-teal btn-sm px-3 py-2">
          <i class="bi bi-people me-1"></i> View Registrations
        </a>
      </div>
    </div>
  </div>
</div>

<div class="py-5 bg-light">
  <div class="container">

    <!-- KPI Metric Cards Row -->
    <div class="row g-4 mb-4">
      <!-- Total Camps -->
      <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100 border-start border-4 border-teal">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="text-muted small text-uppercase fw-bold">Total Camps</span>
            <div class="feature-icon-circle bg-teal-subtle text-teal mb-0" style="width: 40px; height: 40px; font-size: 1.1rem;">
              <i class="bi bi-hospital"></i>
            </div>
          </div>
          <h2 class="fw-bold text-dark mb-1"><%= stats.totalCamps %></h2>
          <div class="small text-muted">
            <span class="text-success fw-bold"><%= stats.upcomingCamps %> upcoming</span> clinics scheduled
          </div>
        </div>
      </div>

      <!-- Total Registrations -->
      <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100 border-start border-4 border-primary">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="text-muted small text-uppercase fw-bold">Total Registrations</span>
            <div class="feature-icon-circle bg-primary-subtle text-primary mb-0" style="width: 40px; height: 40px; font-size: 1.1rem;">
              <i class="bi bi-person-check"></i>
            </div>
          </div>
          <h2 class="fw-bold text-dark mb-1"><%= stats.totalRegistrations %></h2>
          <div class="small text-muted">
            <span class="text-success fw-bold"><%= stats.confirmedRegistrations %> confirmed</span> / <%= stats.cancelledRegistrations %> cancelled
          </div>
        </div>
      </div>

      <!-- Capacity Seats Booked -->
      <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100 border-start border-4 border-info">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="text-muted small text-uppercase fw-bold">Seats Reserved</span>
            <div class="feature-icon-circle bg-info-subtle text-info mb-0" style="width: 40px; height: 40px; font-size: 1.1rem;">
              <i class="bi bi-ticket-perforated"></i>
            </div>
          </div>
          <h2 class="fw-bold text-dark mb-1"><%= stats.totalBooked %></h2>
          <div class="small text-muted">
            out of <strong><%= stats.totalCapacity %></strong> total patient capacity
          </div>
        </div>
      </div>

      <!-- Utilization Rate -->
      <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100 border-start border-4 border-warning">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="text-muted small text-uppercase fw-bold">Capacity Utilization</span>
            <div class="feature-icon-circle bg-warning-subtle text-warning mb-0" style="width: 40px; height: 40px; font-size: 1.1rem;">
              <i class="bi bi-pie-chart-fill"></i>
            </div>
          </div>
          <h2 class="fw-bold text-dark mb-1"><%= stats.utilizationRate %>%</h2>
          <div class="progress mt-2" style="height: 6px;">
            <div class="progress-bar bg-warning" role="progressbar" style="width: <%= stats.utilizationRate %>%;" aria-valuenow="<%= stats.utilizationRate %>" aria-valuemin="0" aria-valuemax="100"></div>
          </div>
        </div>
      </div>
    </div>

    <div class="row g-4">
      <!-- Left Column: Recent Registrations Table -->
      <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
          <div class="p-4 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
              <h5 class="fw-bold text-dark mb-0">Recent Participant Registrations</h5>
              <div class="small text-muted">Latest patient registrations recorded in the database</div>
            </div>
            <a href="/admin/registrations" class="btn btn-outline-teal btn-sm">
              View All (<%= stats.totalRegistrations %>)
            </a>
          </div>

          <div class="table-responsive">
            <table class="table admin-table mb-0">
              <thead>
                <tr>
                  <th>Reference</th>
                  <th>Patient Name</th>
                  <th>Medical Camp</th>
                  <th>Status</th>
                  <th>Date Registered</th>
                </tr>
              </thead>
              <tbody>
                <% if (recentRegistrations && recentRegistrations.length > 0) { %>
                  <% recentRegistrations.forEach(reg => { %>
                    <tr>
                      <td>
                        <a href="/registrations/confirmation/<%= reg.registrationReference %>" target="_blank" class="fw-bold text-teal text-decoration-none">
                          <%= reg.registrationReference %>
                        </a>
                      </td>
                      <td>
                        <div class="fw-semibold text-dark"><%= reg.fullName %></div>
                        <div class="text-muted small"><%= reg.contactNumber %> &bull; <%= reg.age %>y</div>
                      </td>
                      <td>
                        <div class="small fw-semibold text-dark text-truncate" style="max-width: 200px;">
                          <%= reg.campId ? reg.campId.name : 'Unknown Camp' %>
                        </div>
                        <div class="text-muted small"><%= reg.campId ? reg.campId.location.city : '' %></div>
                      </td>
                      <td>
                        <% if (reg.registrationStatus === 'Confirmed') { %>
                          <span class="badge bg-success-subtle text-success border border-success-subtle">Confirmed</span>
                        <% } else if (reg.registrationStatus === 'Attended') { %>
                          <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Attended</span>
                        <% } else { %>
                          <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Cancelled</span>
                        <% } %>
                      </td>
                      <td class="text-muted small">
                        <%= new Date(reg.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="5" class="text-center py-4 text-muted">
                      No registrations found.
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Right Column: Camps Capacity Overview -->
      <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold text-dark mb-0">Camp Capacity Live Feed</h5>
            <a href="/admin/camps" class="small text-teal text-decoration-none fw-semibold">Manage</a>
          </div>

          <div class="d-flex flex-column gap-3">
            <% if (upcomingCampsList && upcomingCampsList.length > 0) { %>
              <% upcomingCampsList.forEach(c => { %>
                <div class="p-3 bg-light rounded-3 border">
                  <div class="d-flex justify-content-between align-items-start mb-1">
                    <strong class="text-dark small text-truncate" style="max-width: 220px;" title="<%= c.name %>"><%= c.name %></strong>
                    <span class="badge <%= c.status === 'Upcoming' ? 'bg-primary' : 'bg-secondary' %> small"><%= c.status %></span>
                  </div>
                  <div class="small text-muted mb-2"><i class="bi bi-geo-alt me-1"></i><%= c.location.city %> &bull; <%= c.formattedDate %></div>

                  <% const campPct = Math.round((c.registrationCount / c.capacity) * 100); %>
                  <div class="d-flex justify-content-between small text-muted mb-1">
                    <span><%= c.registrationCount %> / <%= c.capacity %> Seats</span>
                    <strong class="<%= campPct >= 90 ? 'text-danger' : 'text-teal' %>"><%= campPct %>%</strong>
                  </div>
                  <div class="progress" style="height: 6px;">
                    <div class="progress-bar <%= campPct >= 90 ? 'bg-danger' : campPct >= 70 ? 'bg-warning' : 'bg-teal' %>" style="width: <%= campPct %>%;"></div>
                  </div>
                </div>
              <% }) %>
            <% } else { %>
              <div class="text-muted small text-center py-3">No camps configured.</div>
            <% } %>
          </div>
        </div>

        <!-- Quick System Tools -->
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
          <h6 class="fw-bold text-dark mb-3 small text-uppercase">Administrative Quick Actions</h6>
          <div class="d-grid gap-2">
            <a href="/admin/camps/new" class="btn btn-outline-teal btn-sm text-start py-2">
              <i class="bi bi-plus-circle me-2"></i> Add New Medical Camp
            </a>
            <a href="/admin/camps" class="btn btn-outline-secondary btn-sm text-start py-2">
              <i class="bi bi-gear me-2"></i> Edit Existing Camp Listings
            </a>
            <a href="/admin/registrations" class="btn btn-outline-secondary btn-sm text-start py-2">
              <i class="bi bi-person-x me-2"></i> Manage / Cancel Registrations
            </a>
            <a href="/" target="_blank" class="btn btn-outline-secondary btn-sm text-start py-2">
              <i class="bi bi-box-arrow-up-right me-2"></i> Open Public Patient Portal
            </a>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>
