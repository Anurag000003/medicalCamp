<% layout('layouts/boilerplate') -%>

<div class="py-4 bg-white border-bottom">
  <div class="container">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb small mb-1">
        <li class="breadcrumb-item"><a href="/admin/dashboard" class="text-teal text-decoration-none">Admin</a></li>
        <li class="breadcrumb-item"><a href="/admin/camps" class="text-teal text-decoration-none">Medical Camps</a></li>
        <li class="breadcrumb-item active" aria-current="page"><%= isEdit ? 'Edit Camp' : 'New Camp' %></li>
      </ol>
    </nav>
    <h1 class="h3 fw-bold text-dark mb-0"><%= isEdit ? `Edit Camp: ${camp.name}` : 'Create New Medical Outreach Camp' %></h1>
    <p class="text-secondary small mb-0"><%= isEdit ? 'Update camp schedule, capacity, and clinical service details.' : 'Publish a new community healthcare screening drive.' %></p>
  </div>
</div>

<div class="py-5 bg-light">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-10">

        <!-- Errors display -->
        <% if (formErrors && formErrors.length > 0) { %>
          <div class="alert alert-danger shadow-sm border-0 mb-4" role="alert">
            <div class="d-flex align-items-center mb-2">
              <i class="bi bi-exclamation-triangle-fill fs-5 me-2 text-danger"></i>
              <strong class="fs-6">Please correct the following errors:</strong>
            </div>
            <ul class="mb-0 ps-3 small">
              <% formErrors.forEach(err => { %>
                <li><%= err.msg %></li>
              <% }) %>
            </ul>
          </div>
        <% } %>

        <div class="form-card p-4 p-md-5">
          <form action="<%= isEdit ? `/admin/camps/${camp._id}?_method=PUT` : '/admin/camps' %>" method="POST">
            
            <!-- Basic Details -->
            <h5 class="fw-bold text-dark mb-3 border-start border-3 border-teal ps-2">1. Basic Information</h5>
            
            <div class="mb-3">
              <label for="campName" class="form-label">Medical Camp Name <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="campName" name="name" value="<%= formData.name || (camp ? camp.name : '') %>" placeholder="e.g. Community Comprehensive Heart &amp; Vitals Camp" required>
            </div>

            <div class="mb-4">
              <label for="campDescription" class="form-label">Full Camp Description <span class="text-danger">*</span></label>
              <textarea class="form-control" id="campDescription" name="description" rows="3" placeholder="Explain the focus, medical benefits, target demographic, and doctors participating..." required><%= formData.description || (camp ? camp.description : '') %></textarea>
            </div>

            <!-- Date, Timing & Capacity -->
            <h5 class="fw-bold text-dark mb-3 border-start border-3 border-teal ps-2">2. Schedule &amp; Capacity Limits</h5>
            
            <div class="row g-3 mb-4">
              <div class="col-md-4">
                <label for="campDate" class="form-label">Camp Date <span class="text-danger">*</span></label>
                <% 
                  let dateVal = '';
                  if (formData.date) {
                    dateVal = formData.date;
                  } else if (camp && camp.date) {
                    dateVal = new Date(camp.date).toISOString().split('T')[0];
                  }
                %>
                <input type="date" class="form-control" id="campDate" name="date" value="<%= dateVal %>" required>
              </div>

              <div class="col-md-4">
                <label for="startTime" class="form-label">Start Time <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="startTime" name="startTime" value="<%= formData.startTime || (camp ? camp.startTime : '09:00 AM') %>" placeholder="e.g. 09:00 AM" required>
              </div>

              <div class="col-md-4">
                <label for="endTime" class="form-label">End Time <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="endTime" name="endTime" value="<%= formData.endTime || (camp ? camp.endTime : '03:00 PM') %>" placeholder="e.g. 03:00 PM" required>
              </div>

              <div class="col-md-6">
                <label for="campCapacity" class="form-label">Total Registration Capacity <span class="text-danger">*</span></label>
                <input type="number" class="form-control" id="campCapacity" name="capacity" value="<%= formData.capacity || (camp ? camp.capacity : '100') %>" min="1" required>
                <% if (isEdit && camp) { %>
                  <div class="form-text text-muted">Currently <%= camp.registrationCount %> participants registered. Capacity cannot be lower than this.</div>
                <% } %>
              </div>

              <div class="col-md-6">
                <label for="campStatus" class="form-label">Camp Status <span class="text-danger">*</span></label>
                <% const currentStatus = formData.status || (camp ? camp.status : 'Upcoming'); %>
                <select class="form-select" id="campStatus" name="status" required>
                  <option value="Upcoming" <%= currentStatus === 'Upcoming' ? 'selected' : '' %>>Upcoming</option>
                  <option value="Ongoing" <%= currentStatus === 'Ongoing' ? 'selected' : '' %>>Ongoing (Active Today)</option>
                  <option value="Completed" <%= currentStatus === 'Completed' ? 'selected' : '' %>>Completed</option>
                  <option value="Cancelled" <%= currentStatus === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
                </select>
              </div>
            </div>

            <!-- Venue & Location -->
            <h5 class="fw-bold text-dark mb-3 border-start border-3 border-teal ps-2">3. Venue &amp; Location Address</h5>
            
            <div class="row g-3 mb-4">
              <div class="col-md-6">
                <label for="venue" class="form-label">Venue / Facility Name <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="venue" name="venue" value="<%= formData.venue || (camp && camp.location ? camp.location.venue : '') %>" placeholder="e.g. City Civic Hall, Auditorium B" required>
              </div>

              <div class="col-md-6">
                <label for="address" class="form-label">Street Address <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="address" name="address" value="<%= formData.address || (camp && camp.location ? camp.location.address : '') %>" placeholder="e.g. 100 Government Plaza" required>
              </div>

              <div class="col-md-4">
                <label for="city" class="form-label">City <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="city" name="city" value="<%= formData.city || (camp && camp.location ? camp.location.city : '') %>" placeholder="e.g. Springfield" required>
              </div>

              <div class="col-md-4">
                <label for="state" class="form-label">State / Region</label>
                <input type="text" class="form-control" id="state" name="state" value="<%= formData.state || (camp && camp.location ? camp.location.state : 'Illinois') %>" placeholder="e.g. Illinois">
              </div>

              <div class="col-md-4">
                <label for="pincode" class="form-label">Postal / Zip Code</label>
                <input type="text" class="form-control" id="pincode" name="pincode" value="<%= formData.pincode || (camp && camp.location ? camp.location.pincode : '') %>" placeholder="e.g. 62701">
              </div>
            </div>

            <!-- Medical Specialties & Services -->
            <h5 class="fw-bold text-dark mb-3 border-start border-3 border-teal ps-2">4. Specialties &amp; Services Offered</h5>
            
            <div class="row g-3 mb-4">
              <div class="col-md-6">
                <label for="specialties" class="form-label">Medical Specialties <span class="text-danger">*</span></label>
                <% 
                  const specVal = formData.specialties 
                    ? (Array.isArray(formData.specialties) ? formData.specialties.join(', ') : formData.specialties)
                    : (camp && camp.specialties ? camp.specialties.join(', ') : '');
                %>
                <input type="text" class="form-control" id="specialties" name="specialties" value="<%= specVal %>" placeholder="Cardiology, General Medicine, Pediatrics" required>
                <div class="form-text">Comma-separated list of medical branches available.</div>
              </div>

              <div class="col-md-6">
                <label for="services" class="form-label">Available Free Services <span class="text-danger">*</span></label>
                <% 
                  const servVal = formData.services 
                    ? (Array.isArray(formData.services) ? formData.services.join(', ') : formData.services)
                    : (camp && camp.services ? camp.services.join(', ') : '');
                %>
                <input type="text" class="form-control" id="services" name="services" value="<%= servVal %>" placeholder="Free ECG, Blood Pressure Check, Glucose Test" required>
                <div class="form-text">Comma-separated list of tests and services.</div>
              </div>

              <div class="col-12">
                <label for="image" class="form-label">Camp Image URL</label>
                <input type="url" class="form-control" id="image" name="image" value="<%= formData.image || (camp ? camp.image : '') %>" placeholder="https://images.unsplash.com/photo-...">
                <div class="form-text">Leave blank to use default medical banner.</div>
              </div>
            </div>

            <!-- Organizer & Contacts -->
            <h5 class="fw-bold text-dark mb-3 border-start border-3 border-teal ps-2">5. Organizer &amp; Contact Information</h5>
            
            <div class="row g-3 mb-4">
              <div class="col-md-4">
                <label for="organizerName" class="form-label">Organizer / Foundation Name <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="organizerName" name="organizerName" value="<%= formData.organizerName || (camp && camp.organizer ? camp.organizer.name : '') %>" placeholder="e.g. HeartGuard Outreach Foundation" required>
              </div>

              <div class="col-md-4">
                <label for="hospital" class="form-label">Partner Hospital / Clinic</label>
                <input type="text" class="form-control" id="hospital" name="hospital" value="<%= formData.hospital || (camp && camp.organizer ? camp.organizer.hospital : '') %>" placeholder="e.g. St. Jude Cardiac Institute">
              </div>

              <div class="col-md-4">
                <label for="contactPerson" class="form-label">Lead Doctor / Coordinator</label>
                <input type="text" class="form-control" id="contactPerson" name="contactPerson" value="<%= formData.contactPerson || (camp && camp.organizer ? camp.organizer.contactPerson : '') %>" placeholder="e.g. Dr. Evelyn Reed, MD">
              </div>

              <div class="col-md-4">
                <label for="contactPhone" class="form-label">Contact Phone Number <span class="text-danger">*</span></label>
                <input type="tel" class="form-control" id="contactPhone" name="contactPhone" value="<%= formData.contactPhone || (camp && camp.contactInformation ? camp.contactInformation.phone : '') %>" placeholder="e.g. +1 (555) 234-5678" required>
              </div>

              <div class="col-md-4">
                <label for="contactEmail" class="form-label">Contact Email Address <span class="text-danger">*</span></label>
                <input type="email" class="form-control" id="contactEmail" name="contactEmail" value="<%= formData.contactEmail || (camp && camp.contactInformation ? camp.contactInformation.email : '') %>" placeholder="e.g. info@medicaloutreach.org" required>
              </div>

              <div class="col-md-4">
                <label for="helpline" class="form-label">Toll-Free Helpline</label>
                <input type="text" class="form-control" id="helpline" name="helpline" value="<%= formData.helpline || (camp && camp.contactInformation ? camp.contactInformation.helpline : '') %>" placeholder="e.g. 1-800-MED-CAMP">
              </div>
            </div>

            <!-- Form Actions -->
            <div class="d-flex justify-content-between align-items-center pt-3 border-top">
              <a href="/admin/camps" class="btn btn-outline-secondary px-4">
                <i class="bi bi-arrow-left me-1"></i> Cancel
              </a>
              <button type="submit" class="btn btn-teal px-5 py-2 fw-bold">
                <i class="bi bi-check-circle me-1"></i> <%= isEdit ? 'Save Changes' : 'Publish Medical Camp' %>
              </button>
            </div>
          </form>
        </div>

      </div>
    </div>
  </div>
</div>
