# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/medical_camp_portal

# Session Secret (Use a strong random string in production)
SESSION_SECRET=replace_with_a_secure_random_session_secret_in_production

# Default Admin Credentials (used during script seeding only)
ADMIN_DEFAULT_EMAIL=admin@medicalcamp.org
ADMIN_DEFAULT_PASSWORD=Admin@12345
ADMIN_DEFAULT_NAME=Chief Medical Administrator
